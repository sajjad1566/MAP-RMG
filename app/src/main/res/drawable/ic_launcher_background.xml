<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's background: a light neutral field. The official artwork is a pale, high-key
     map, so it supplies nearly the whole 108dp layer itself (@mipmap/ic_launcher_foreground, 62%);
     this only backs the small margin a launcher's mask can expose, and white keeps the icon's own
     frame reading as the edge of the shape instead of a dark ring around it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/maprmg_icon_background" />
</shape>
