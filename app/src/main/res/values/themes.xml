<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pre-Compose window theme only (splash + system bars). All real
         coloring is done by VelaTheme in Compose. Uses a plain AOSP parent so
         we don't drag in the Material Components XML library. -->
    <style name="Theme.Vela" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- The window MainActivity starts in: brand dark blue behind a white disc carrying the
         official mark, so the first frame of a launch is already MAP-RMG (androidx core-splashscreen
         draws this on every API level; installSplashScreen() hands over to Theme.Vela once the app
         is up). The disc is what keeps a pale map legible on the dark window. -->
    <style name="Theme.Vela.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/maprmg_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Vela</item>
    </style>
</resources>
