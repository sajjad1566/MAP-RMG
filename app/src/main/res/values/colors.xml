<resources>
    <!-- MAP-RMG brand palette (2026-10-15). Compose reads the same values from
         ui/theme/Color.kt (VelaTeal / VelaAmber and the gold settings tokens); these XML colors
         are for the pre-Compose window (splash, system bars) and anything XML-side, so the very
         first frame is already MAP-RMG rather than a blank light window.
         The launcher background is @drawable/ic_launcher_background (brand gradient). -->
    <color name="maprmg_royal_blue">#FF2457D6</color>
    <color name="maprmg_gold">#FFD4AF37</color>
    <color name="maprmg_dark_blue">#FF0B1C3D</color>
    <color name="maprmg_white">#FFFFFFFF</color>
    <color name="maprmg_pale_gold">#FFFFF8EC</color>
    <color name="maprmg_gold_icon">#FFB8860B</color>
    <!-- The splash background: the brand's dark blue, so the launch reads as MAP-RMG before the
         map is drawn. -->
    <color name="maprmg_splash_background">@color/maprmg_dark_blue</color>
</resources>
