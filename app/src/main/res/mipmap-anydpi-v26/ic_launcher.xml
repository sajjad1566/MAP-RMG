<?xml version="1.0" encoding="utf-8"?>
<!-- API 26+: the adaptive MAP-RMG icon. Background = the brand gradient, foreground = the official
     artwork (tools/make-brand-assets.py renders it at 70% of the 108dp layer, which is what the
     launcher's mask may crop), monochrome = the themed-icon silhouette. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
